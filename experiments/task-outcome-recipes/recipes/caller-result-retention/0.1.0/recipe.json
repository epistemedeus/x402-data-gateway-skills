{
  "schema": "h64006.task-outcome-recipe.v1",
  "id": "caller-result-retention",
  "version": "0.1.0",
  "task": "Keep an already delivered MCP tool result for this task, then keep a second task's result without replacing the first. A tool error is not a successful keep.",
  "consumer": "An agent that already holds a CallToolResult JSON and needs the bytes retained with an explicit tool-error class.",
  "capability": {
    "skill": "samedaydesk-task-result",
    "skillVersion": "0.1.0",
    "callerPackage": "samedaydesk-caller-result",
    "callerVersion": "0.1.1",
    "acquisition": "cli",
    "sdk": "@modelcontextprotocol/sdk@1.30.0",
    "sdkInstalled": false,
    "command": "node scripts/task-result.mjs retain --result RESULT.json --out COPY.json",
    "documentedInstall": "npx skills add epistemedeus/x402-data-gateway-skills --skill samedaydesk-task-result --yes",
    "installExecuted": false,
    "acquireExecuted": false,
    "reason": "retain is source-closed. acquire and SDK recovery need the published caller archive and are not run."
  },
  "inputs": ["--result caller-owned CallToolResult JSON", "--out a new file"],
  "outputs": ["outcome retained or tool_refusal", "sha256", "retainedBytesMatch", "isError", "usefulness", "paymentCreated"],
